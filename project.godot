; Native driving simulation, original assets.
config_version=5

[application]
config/name="Vehicle Physics"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
reflections/reflection_atlas/reflection_size=512
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.8, 1)
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4

[audio]
driver/enable_input=false
